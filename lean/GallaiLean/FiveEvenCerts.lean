/-- Lookup with a dummy default. -/
def localCert (k : ℕ) : List (Fin 5 × Fin 5) × Fin 5 × Prog 5 :=
  (localTable.lookup k).getD ([], 0, .done)

def bowCert (k : ℕ) : List (Fin 7 × Fin 7) × Fin 7 × Prog 7 :=
  (bowTable.lookup k).getD ([], 0, .done)

/-- No rim vertex is adjacent to the other three rim vertices. -/
def noOtherUniversal (r0 r1 r2 r3 r4 r5 : Bool) : Bool :=
  decide (∀ i : Fin 5, i ≠ 0 → ∃ j : Fin 5, j ≠ 0 ∧ j ≠ i ∧ madj5 r0 r1 r2 r3 r4 r5 i j = false)

/-- Some rim vertex does not have exactly one rim neighbour (the rim is not a perfect matching). -/
def notMatching (r0 r1 r2 r3 r4 r5 : Bool) : Bool :=
  decide (∃ i : Fin 5, i ≠ 0 ∧
    (Finset.univ.filter (fun j : Fin 5 => j ≠ 0 ∧ madj5 r0 r1 r2 r3 r4 r5 i j = true)).card ≠ 1)

/-- The rim is a perfect matching (in the seven-vertex model). -/
def isMatching7 (r0 r1 r2 r3 r4 r5 a0 a1 a2 a3 a4 : Bool) : Bool :=
  decide (∀ i : Fin 7, 0 < i.val → i.val < 5 →
    (Finset.univ.filter (fun j : Fin 7 => 0 < j.val ∧ j.val < 5 ∧
      madj7 r0 r1 r2 r3 r4 r5 a0 a1 a2 a3 a4 i j = true)).card = 1)

/-- All 38 local certificates check. -/
theorem local_ok : ∀ r0 r1 r2 r3 r4 r5 : Bool,
    noOtherUniversal r0 r1 r2 r3 r4 r5 = true → notMatching r0 r1 r2 r3 r4 r5 = true →
    checkCert (madj5 r0 r1 r2 r3 r4 r5) (fun _ => 0)
      (localCert (code6 r0 r1 r2 r3 r4 r5)) = true := by
  decide +kernel

/-- All 93 bowtie certificates check. -/
theorem bow_ok : ∀ r0 r1 r2 r3 r4 r5 a0 a1 a2 a3 a4 : Bool,
    isMatching7 r0 r1 r2 r3 r4 r5 a0 a1 a2 a3 a4 = true → (a0 || a1 || a2 || a3 || a4) = true →
    checkCert (madj7 r0 r1 r2 r3 r4 r5 a0 a1 a2 a3 a4) ![0, 0, 0, 0, 0, 1, 1]
      (bowCert (64 * code5 a0 a1 a2 a3 a4 + code6 r0 r1 r2 r3 r4 r5)) = true := by
  decide +kernel

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Transport of a checked certificate. -/
theorem floor_of_checkCert (W : SimpleGraph V) [DecidableRel W.Adj] {n : ℕ} (ι : Fin n → V)
    (hι : Function.Injective ι) (madj : Fin n → Fin n → Bool) (par : Fin n → ℕ)
    (c : List (Fin n × Fin n) × Fin n × Prog n)
    (hm : ∀ a b, W.Adj (ι a) (ι b) ↔ madj a b = true)
    (hpar : ∀ a, W.degree (ι a) % 2 = par a)
    (hout : ∀ v, v ∉ Set.range ι → Odd (W.degree v))
    (hc : checkCert madj par c = true) :
    ∃ D : PathDecomp W, 2 * D.size + 1 = Fintype.card V := by
  simp only [checkCert, Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨⟨hsub, hp⟩, hok⟩ := hc
  refine floor_of_cert W ι hι madj (ofPairs c.1) c.2.2 c.2.1 hm hsub (ofPairs_symm c.1) hout
    (fun a => ?_) hok
  rw [← hp a]
  have := hpar a
  omega

/-- **Five even vertices, one universal vertex, not a bowtie** (manuscript Theorem 1(a)).
`ι` lists the even vertices, `ι 0` is adjacent to the others, no other one is adjacent to all
the others, and the other four do not induce a perfect matching. Then `W` has a partition into
`(|V| − 1)/2` paths. -/
theorem five_even_local (W : SimpleGraph V) [DecidableRel W.Adj] (ι : Fin 5 → V)
    (hι : Function.Injective ι) (heven : ∀ i, Even (W.degree (ι i)))
    (hout : ∀ v, v ∉ Set.range ι → Odd (W.degree v))
    (hx : ∀ i, i ≠ 0 → W.Adj (ι 0) (ι i))
    (hnu : ∀ i, i ≠ 0 → ∃ j, j ≠ 0 ∧ j ≠ i ∧ ¬ W.Adj (ι i) (ι j))
    (hnb : ∃ i, i ≠ 0 ∧ (Finset.univ.filter (fun j => j ≠ 0 ∧ W.Adj (ι i) (ι j))).card ≠ 1) :
    ∃ D : PathDecomp W, 2 * D.size + 1 = Fintype.card V := by
  have hm : ∀ a b, W.Adj (ι a) (ι b) ↔ madj5 (decide (W.Adj (ι 1) (ι 2)))
      (decide (W.Adj (ι 1) (ι 3))) (decide (W.Adj (ι 1) (ι 4))) (decide (W.Adj (ι 2) (ι 3)))
      (decide (W.Adj (ι 2) (ι 4))) (decide (W.Adj (ι 3) (ι 4))) a b = true := by
    have h01 := hx 1 (by decide)
    have h02 := hx 2 (by decide)
    have h03 := hx 3 (by decide)
    have h04 := hx 4 (by decide)
    intro a b
    fin_cases a <;> fin_cases b <;>
      simp [madj5, h01, h02, h03, h04, h01.symm, h02.symm, h03.symm, h04.symm,
        W.adj_comm (ι 2) (ι 1), W.adj_comm (ι 3) (ι 1), W.adj_comm (ι 4) (ι 1),
        W.adj_comm (ι 3) (ι 2), W.adj_comm (ι 4) (ι 2), W.adj_comm (ι 4) (ι 3)]
  refine floor_of_checkCert W ι hι _ (fun _ => 0) _ hm
    (fun a => Nat.even_iff.mp (heven a)) hout (local_ok _ _ _ _ _ _ ?_ ?_)
  · simp only [noOtherUniversal, decide_eq_true_eq]
    intro i hi
    obtain ⟨j, hj0, hji, hj⟩ := hnu i hi
    refine ⟨j, hj0, hji, ?_⟩
    rw [← Bool.not_eq_true, ← hm]
    exact hj
  · simp only [notMatching, decide_eq_true_eq]
    obtain ⟨i, hi0, hi⟩ := hnb
    refine ⟨i, hi0, ?_⟩
    simp only [← hm]
    exact hi

omit [Fintype V] [DecidableEq V] in
theorem contact_or (W : SimpleGraph V) [DecidableRel W.Adj] (ι : Fin 7 → V)
    (h : ∃ i : Fin 7, i.val < 5 ∧ W.Adj (ι 5) (ι i)) :
    (decide (W.Adj (ι 5) (ι 0)) || decide (W.Adj (ι 5) (ι 1)) || decide (W.Adj (ι 5) (ι 2)) ||
      decide (W.Adj (ι 5) (ι 3)) || decide (W.Adj (ι 5) (ι 4))) = true := by
  obtain ⟨⟨i, hi7⟩, hi, hadj⟩ := h
  simp only at hi
  interval_cases i <;> simp_all

/-- **The bowtie** (manuscript Theorem 1(b)). `ι 0, …, ι 4` are the even vertices, `ι 0` is
adjacent to `ι 1, …, ι 4`, which induce a perfect matching; `u = ι 5` and `v = ι 6` are odd and
adjacent, `u` has a neighbour among the even vertices and `v` has none. Then `W` has a partition
into `(|V| − 1)/2` paths. -/
theorem five_even_bowtie (W : SimpleGraph V) [DecidableRel W.Adj] (ι : Fin 7 → V)
    (hι : Function.Injective ι) (heven : ∀ i : Fin 7, i.val < 5 → Even (W.degree (ι i)))
    (hu : Odd (W.degree (ι 5))) (hv : Odd (W.degree (ι 6)))
    (hout : ∀ v, v ∉ Set.range ι → Odd (W.degree v))
    (hx : ∀ i : Fin 7, 0 < i.val → i.val < 5 → W.Adj (ι 0) (ι i))
    (hmatch : ∀ i : Fin 7, 0 < i.val → i.val < 5 →
      (Finset.univ.filter (fun j : Fin 7 => 0 < j.val ∧ j.val < 5 ∧ W.Adj (ι i) (ι j))).card = 1)
    (huv : W.Adj (ι 5) (ι 6)) (hvT : ∀ i : Fin 7, i.val < 5 → ¬ W.Adj (ι 6) (ι i))
    (huT : ∃ i : Fin 7, i.val < 5 ∧ W.Adj (ι 5) (ι i)) :
    ∃ D : PathDecomp W, 2 * D.size + 1 = Fintype.card V := by
  have h01 := hx 1 (by decide) (by decide)
  have h02 := hx 2 (by decide) (by decide)
  have h03 := hx 3 (by decide) (by decide)
  have h04 := hx 4 (by decide) (by decide)
  have h60 := hvT 0 (by decide)
  have h61 := hvT 1 (by decide)
  have h62 := hvT 2 (by decide)
  have h63 := hvT 3 (by decide)
  have h64 := hvT 4 (by decide)
  have h06 : ¬ W.Adj (ι 0) (ι 6) := fun h => h60 h.symm
  have h16 : ¬ W.Adj (ι 1) (ι 6) := fun h => h61 h.symm
  have h26 : ¬ W.Adj (ι 2) (ι 6) := fun h => h62 h.symm
  have h36 : ¬ W.Adj (ι 3) (ι 6) := fun h => h63 h.symm
  have h46 : ¬ W.Adj (ι 4) (ι 6) := fun h => h64 h.symm
  have hm : ∀ a b, W.Adj (ι a) (ι b) ↔ madj7 (decide (W.Adj (ι 1) (ι 2)))
      (decide (W.Adj (ι 1) (ι 3))) (decide (W.Adj (ι 1) (ι 4))) (decide (W.Adj (ι 2) (ι 3)))
      (decide (W.Adj (ι 2) (ι 4))) (decide (W.Adj (ι 3) (ι 4))) (decide (W.Adj (ι 5) (ι 0)))
      (decide (W.Adj (ι 5) (ι 1))) (decide (W.Adj (ι 5) (ι 2))) (decide (W.Adj (ι 5) (ι 3)))
      (decide (W.Adj (ι 5) (ι 4))) a b = true := by
    intro a b
    fin_cases a <;> fin_cases b <;>
      simp [madj7, huv, huv.symm, h01, h02, h03, h04, h01.symm, h02.symm, h03.symm, h04.symm,
        h60, h61, h62, h63, h64, h06, h16, h26, h36, h46,
        W.adj_comm (ι 2) (ι 1), W.adj_comm (ι 3) (ι 1), W.adj_comm (ι 4) (ι 1),
