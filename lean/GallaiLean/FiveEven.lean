import GallaiLean.Schedule
import GallaiLean.EMCFour
import GallaiLean.Lovasz

/-!
# Five even vertices with one universal vertex

Manuscript `manuscripts/bs-prescribed` (Theorem 1). Let `W` have exactly five even vertices `T`
(every other vertex odd), and let `x ∈ T` be adjacent to the other four. If no other vertex of `T`
is adjacent to all of `T` and the *rim* `W[T ∖ x]` is not a perfect matching (so `W[T]` is not a
bowtie), then `W` has a path decomposition `D` with `2|D| + 1 = |V|`, i.e. `⌊|V|/2⌋` paths
(`five_even_local`). For the bowtie the same holds when there are adjacent odd vertices `u, v` with
`u` adjacent to some vertex of `T` and `v` to none (`five_even_bowtie`).

## Method

Every case is a *Lovász–Fan certificate* on a model `Fin n` (`n = 5`: the even vertices;
`n = 7`: also `u = 5`, `v = 6`): hold a set of model edges so that exactly one model vertex has even
degree; take the exact Lovász partition of `W − H` (`lovasz_ends`); restore the held edges by
Fan's grouped transfers (`Ach.grouped`). The program is checked on the model by kernel
evaluation, and replayed on `W` by `soundS`, a variant of `Prog.sound` (Schedule.lean) whose leaves
need not share one end vector: different donors returned by a grouped transfer lead to different
final vectors, and only the number of paths matters. Vertices outside the model keep one end, so
they are never blank, and the model check bounds the real blank counts.

The certificate tables are generated by `manuscripts/bs-prescribed/scripts/certgen.py` and
checked independently by `verify_certs.py`: 38 local certificates (one for each labelled rim of
maximum degree at most two that is not a perfect matching) and 93 bowtie certificates (3 labelled
bowties times the 31 nonempty contact sets of `u`).
-/

open SimpleGraph

namespace Gallai

namespace FiveEven

universe u

open Prog

/-! ### A checker with free leaf vectors -/

/-- Like `Prog.ok`, but a leaf only requires that the inserted edges are exactly `T`. -/
def okS {n : ℕ} (T : Fin n → Fin n → Bool) :
    Prog n → (Fin n → Fin n → Bool) → (Fin n → Fin n → Bool) → (Fin n → ℕ) → Bool
  | .done, _, ins, _ => decide (∀ a b, ins a b = T a b)
  | .offer ds r k, adj, ins, c =>
      decide (r ∉ ds) && decide ds.Nodup && decide (∀ t ∈ ds, adj t r = false) &&
      decide (mblank adj c r < (ds.map c).sum) &&
      ds.attach.all (fun t => decide (c t.1 = 0) ||
        okS T (k t.1) (bupd adj t.1 r) (bupd ins t.1 r) (mv c t.1 r))

/-- Moving one end keeps the total number of ends. -/
theorem sum_mv {W : Type*} [Fintype W] [DecidableEq W] (b : W → ℕ) {t r : W} (htr : t ≠ r)
    (ht : 1 ≤ b t) : ∑ v, mv b t r v = ∑ v, b v := by
  have hr : r ∈ (Finset.univ : Finset W) := Finset.mem_univ r
  have ht' : t ∈ (Finset.univ : Finset W).erase r := Finset.mem_erase.mpr ⟨htr, Finset.mem_univ t⟩
  rw [← Finset.add_sum_erase _ _ hr, ← Finset.add_sum_erase _ _ hr,
    ← Finset.add_sum_erase _ _ ht', ← Finset.add_sum_erase _ _ ht']
  have hrest : ∑ v ∈ ((Finset.univ : Finset W).erase r).erase t, mv b t r v =
      ∑ v ∈ ((Finset.univ : Finset W).erase r).erase t, b v := by
    apply Finset.sum_congr rfl
    intro v hv
    simp only [Finset.mem_erase] at hv
    exact mv_apply_other b hv.1 hv.2.1
  rw [hrest, mv_apply_recv, mv_apply_donor b htr]
  omega

/-- **Soundness of `okS`**: the program can be replayed on any graph whose blank vertices lie in
the image of the model; the total number of ends is unchanged. -/
theorem soundS {V : Type u} [DecidableEq V] [Fintype V] {n : ℕ} (ι : Fin n → V)
    (hι : Function.Injective ι) (T : Fin n → Fin n → Bool)
    (E₀ : Set (Sym2 V)) (b₀ : V → ℕ) (hb₀ : ∀ v, v ∉ Set.range ι → 0 < b₀ v) :
    ∀ (P : Prog n) (adj ins : Fin n → Fin n → Bool) (c : Fin n → ℕ) (b : V → ℕ),
      okS T P adj ins c = true →
      Ach (E₀ ∪ img ι ins) b →
      (∀ a, b (ι a) = c a) →
      (∀ v, v ∉ Set.range ι → b v = b₀ v) →
      (∀ a a', a ≠ a' → s(ι a, ι a') ∈ E₀ ∪ img ι ins → adj a a' = true) →
      ∃ b', Ach (E₀ ∪ img ι T) b' ∧ ∑ v, b' v = ∑ v, b v := by
  intro P
  induction P with
  | done =>
    intro adj ins c b hok hach _ _ _
    simp only [okS, decide_eq_true_eq] at hok
    refine ⟨b, ?_, rfl⟩
    rwa [img_congr ι hok] at hach
  | offer ds r k ih =>
    intro adj ins c b hok hach hbc hbo hadj
    simp only [okS, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, Bool.or_eq_true,
      List.mem_attach, true_implies, Subtype.forall] at hok
    obtain ⟨⟨⟨⟨hr, hnd⟩, hna⟩, hlt⟩, hk⟩ := hok
    set E := E₀ ∪ img ι ins with hE
    have huT : ι r ∉ ds.toFinset.image ι := by
      simp only [Finset.mem_image, List.mem_toFinset, not_exists, not_and]
      intro t ht h
      exact hr (hι h ▸ ht)
    have hT : ∀ t ∈ ds.toFinset.image ι, s(t, ι r) ∉ E := by
      simp only [Finset.mem_image, List.mem_toFinset]
      rintro _ ⟨t, ht, rfl⟩ hmem
      have htr : t ≠ r := fun h => hr (h ▸ ht)
      have := hadj t r htr hmem
      rw [hna t ht] at this
      exact Bool.false_ne_true this
    have hblank : blankNbrs E b (ι r) ≤ mblank adj c r := by
      unfold mblank
      rw [← Set.ncard_coe_finset, ← Set.ncard_image_of_injective _ hι]
      apply blankNbrs_le_of_subset
      intro w hw hwr hb0
      by_cases hwι : w ∈ Set.range ι
      · obtain ⟨a, rfl⟩ := hwι
        refine ⟨a, ?_, rfl⟩
        simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_ofPred_eq]
        have har : a ≠ r := fun h => hwr (h ▸ rfl)
        refine ⟨hadj r a (Ne.symm har) hw, har, ?_⟩
        rw [← hbc a]; exact hb0
      · have := hb₀ w hwι
        rw [hbo w hwι] at hb0
        omega
    have hsum : ∑ t ∈ ds.toFinset.image ι, b t = (ds.map c).sum := by
      rw [Finset.sum_image (fun x _ y _ h => hι h), List.sum_toFinset _ hnd]
      congr 1
      exact List.map_congr_left (fun a _ => hbc a)
    obtain ⟨t', ht', ht1, hach'⟩ :=
      hach.grouped (ι r) (ds.toFinset.image ι) huT hT (by omega)
    obtain ⟨t, htds, rfl⟩ : ∃ t ∈ ds, ι t = t' := by
      simpa only [Finset.mem_image, List.mem_toFinset] using ht'
    have htr : t ≠ r := fun h => hr (h ▸ htds)
    have hct : c t ≠ 0 := by rw [← hbc t]; omega
    have hkt : okS T (k t) (Prog.bupd adj t r) (Prog.bupd ins t r) (mv c t r) = true := by
      rcases hk t htds with h | h
      · exact absurd h hct
      · exact h
    obtain ⟨b', hb', hs⟩ := ih t _ _ _ (mv b (ι t) (ι r)) hkt (by
        refine hach'.congr ?_ (fun _ => rfl)
        rw [img_bupd, Set.union_insert]) (by
        intro a
        unfold mv
        simp only [hι.eq_iff, hbc]) (by
        intro v hv
        have h1 : v ≠ ι t := fun h => hv ⟨t, h.symm⟩
        have h2 : v ≠ ι r := fun h => hv ⟨r, h.symm⟩
        rw [mv_apply_other _ h1 h2]
        exact hbo v hv) (by
        intro a a' haa' hmem
        rw [img_bupd, Set.union_insert, Set.mem_insert_iff] at hmem
        simp only [Prog.bupd, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
        rcases hmem with h | h
        · rcases Sym2.eq_iff.mp h with ⟨h1, h2⟩ | ⟨h1, h2⟩
          · exact Or.inl (Or.inr ⟨hι h1, hι h2⟩)
          · exact Or.inr ⟨hι h1, hι h2⟩
        · exact Or.inl (Or.inl (hadj a a' haa' h)))
    refine ⟨b', hb', ?_⟩
    rw [hs, sum_mv b (fun h => htr (hι h)) ht1]

/-! ### Held edges and the Lovász seed -/

/-- The symmetric Boolean relation of a list of pairs. -/
def ofPairs {n : ℕ} (L : List (Fin n × Fin n)) (a b : Fin n) : Bool :=
  L.any (fun p => (p.1 == a && p.2 == b) || (p.1 == b && p.2 == a))

theorem ofPairs_symm {n : ℕ} (L : List (Fin n × Fin n)) (a b : Fin n) :
    ofPairs L a b = ofPairs L b a := by
  unfold ofPairs
  congr 1
  funext p
  rw [Bool.or_comm]

/-- Number of held edges at a model vertex. -/
def hdeg {n : ℕ} (hold : Fin n → Fin n → Bool) (a : Fin n) : ℕ :=
  (Finset.univ.filter (fun b => hold a b = true)).card

/-- The held edges as a finset of `V`. -/
def heldF {V : Type u} [DecidableEq V] {n : ℕ} (ι : Fin n → V) (hold : Fin n → Fin n → Bool) :
    Finset (Sym2 V) :=
  ((Finset.univ : Finset (Fin n × Fin n)).filter (fun p => hold p.1 p.2 = true)).image
    (fun p => s(ι p.1, ι p.2))

theorem coe_heldF {V : Type u} [DecidableEq V] {n : ℕ} (ι : Fin n → V)
    (hold : Fin n → Fin n → Bool) : (heldF ι hold : Set (Sym2 V)) = img ι hold := by
  ext e
  simp only [heldF, img, Finset.coe_image, Finset.coe_filter, Finset.mem_univ, true_and,
    Set.mem_image, Set.mem_ofPred_eq, Prod.exists]
  constructor
  · rintro ⟨a, b, h, rfl⟩; exact ⟨a, b, h, rfl⟩
  · rintro ⟨a, b, h, rfl⟩; exact ⟨a, b, h, rfl⟩

theorem card_heldF_at {V : Type u} [DecidableEq V] {n : ℕ} (ι : Fin n → V)
    (hι : Function.Injective ι) (hold : Fin n → Fin n → Bool)
    (hsymm : ∀ a b, hold a b = hold b a) (a : Fin n) :
    ((heldF ι hold).filter (fun e => ι a ∈ e)).card = hdeg hold a := by
  have : (heldF ι hold).filter (fun e => ι a ∈ e) =
      (Finset.univ.filter (fun b => hold a b = true)).image (fun b => s(ι a, ι b)) := by
    ext e
    simp only [heldF, Finset.mem_filter, Finset.mem_image, Finset.mem_univ, true_and,
      Prod.exists]
    constructor
    · rintro ⟨⟨p, q, h, rfl⟩, hm⟩
      rcases Sym2.mem_iff.mp hm with h1 | h1
      · obtain rfl := hι h1
        exact ⟨q, h, rfl⟩
      · obtain rfl := hι h1
        exact ⟨p, by rw [hsymm]; exact h, Sym2.eq_swap⟩
    · rintro ⟨b, h, rfl⟩
      exact ⟨⟨a, b, h, rfl⟩, Sym2.mem_mk_left _ _⟩
  rw [this, Finset.card_image_of_injective]
  · rfl
  intro b b' h
  exact hι (Sym2.congr_right.mp h)

theorem heldF_out {V : Type u} [DecidableEq V] {n : ℕ} (ι : Fin n → V)
    (hold : Fin n → Fin n → Bool) {v : V} (hv : v ∉ Set.range ι) :
    (heldF ι hold).filter (fun e => v ∈ e) = ∅ := by
  rw [Finset.filter_eq_empty_iff]
  intro e he hm
  simp only [heldF, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
    Prod.exists] at he
  obtain ⟨p, q, -, rfl⟩ := he
  rcases Sym2.mem_iff.mp hm with h | h
  · exact hv ⟨p, h.symm⟩
  · exact hv ⟨q, h.symm⟩

variable {V : Type u} [Fintype V] [DecidableEq V]

/-- **The Lovász seed.** If, after holding the model edges `hold`, exactly the model vertex `z0`
has even degree (all vertices outside the model being odd), then `W − H` has a partition with no
end at `ι z0` and one end everywhere else. -/
theorem seed (W : SimpleGraph V) [DecidableRel W.Adj] {n : ℕ} (ι : Fin n → V)
    (hι : Function.Injective ι) (hold : Fin n → Fin n → Bool)
    (hsub : ∀ a b, hold a b = true → W.Adj (ι a) (ι b))
    (hsymm : ∀ a b, hold a b = hold b a)
    (hout : ∀ v, v ∉ Set.range ι → Odd (W.degree v)) (z0 : Fin n)
    (hpar : ∀ a, (W.degree (ι a) + hdeg hold a) % 2 = if a = z0 then 0 else 1) :
    Ach (W.edgeSet \ img ι hold) (fun v => if v = ι z0 then 0 else 1) := by
  set F := heldF ι hold with hF
  have hFE : ∀ e ∈ F, e ∈ W.edgeSet := by
    intro e he
    simp only [hF, heldF, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
      Prod.exists] at he
    obtain ⟨p, q, h, rfl⟩ := he
    exact hsub p q h
  have hdg := degree_delE W F hFE
  have hgraph : fromEdgeSet (W.edgeSet \ img ι hold) = delE W F := by
    ext a b
    simp only [fromEdgeSet_adj, Set.mem_sdiff, mem_edgeSet, delE_adj, ← coe_heldF ι hold,
      Finset.mem_coe, hF]
    constructor
    · rintro ⟨⟨h1, h2⟩, -⟩; exact ⟨h1, h2⟩
    · rintro ⟨h1, h2⟩; exact ⟨⟨h1, h2⟩, h1.ne⟩
  -- parities in `W − H`
  have hpar' : ∀ v, (delE W F).degree v % 2 = if v = ι z0 then 0 else 1 := by
    intro v
    by_cases hv : v ∈ Set.range ι
    · obtain ⟨a, rfl⟩ := hv
      have h1 := hdg (ι a)
      rw [card_heldF_at ι hι hold hsymm a] at h1
      have h2 := hpar a
      have h3 : (ι a = ι z0) ↔ a = z0 := hι.eq_iff
      rw [show (if ι a = ι z0 then 0 else 1) = (if a = z0 then 0 else 1) by simp only [h3]]
      split_ifs at h2 ⊢ <;> omega
    · have h1 := hdg v
      rw [heldF_out ι hold hv, Finset.card_empty, add_zero] at h1
      have hvz : v ≠ ι z0 := fun h => hv ⟨z0, h.symm⟩
      simp only [hvz, ite_false]
      rw [h1]
      exact Nat.odd_iff.mp (hout v hv)
  have hev : (evenSet (delE W F)).card ≤ 1 := by
    have : evenSet (delE W F) ⊆ {ι z0} := by
      intro v hv
      rw [Finset.mem_singleton]
      by_contra hvz
      rw [mem_evenSet_iff_even] at hv
      have := hpar' v
      simp only [hvz, ite_false] at this
      exact Nat.not_even_iff_odd.mpr (Nat.odd_iff.mpr this) hv.2
    exact (Finset.card_le_card this).trans (by simp)
  obtain ⟨D, hD⟩ := lovasz_ends (delE W F) hev
  unfold Ach
  rw [hgraph]
  exact ⟨D, fun v => by rw [hD v, hpar' v]⟩

/-- **Certificates give the floor.** A checked program on a model of `W` (exact model adjacency
`madj`, held edges `hold`, seed vertex `z0`) yields a partition of `W` into `(|V| − 1)/2` paths. -/
theorem floor_of_cert (W : SimpleGraph V) [DecidableRel W.Adj] {n : ℕ} (ι : Fin n → V)
    (hι : Function.Injective ι) (madj hold : Fin n → Fin n → Bool) (P : Prog n) (z0 : Fin n)
    (hm : ∀ a b, W.Adj (ι a) (ι b) ↔ madj a b = true)
    (hsub : ∀ a b, hold a b = true → madj a b = true)
    (hsymm : ∀ a b, hold a b = hold b a)
    (hout : ∀ v, v ∉ Set.range ι → Odd (W.degree v))
    (hpar : ∀ a, (W.degree (ι a) + hdeg hold a) % 2 = if a = z0 then 0 else 1)
    (hok : okS hold P (fun a b => madj a b && !hold a b) (fun _ _ => false)
      (fun a => if a = z0 then 0 else 1) = true) :
    ∃ D : PathDecomp W, 2 * D.size + 1 = Fintype.card V := by
  have hsubW : ∀ a b, hold a b = true → W.Adj (ι a) (ι b) := fun a b h => (hm a b).mpr (hsub a b h)
  have hach := seed W ι hι hold hsubW hsymm hout z0 hpar
  have he0 : img ι (fun _ _ => false) = (∅ : Set (Sym2 V)) := by ext e; simp [img]
  obtain ⟨b', hb', hsum⟩ := soundS ι hι hold (W.edgeSet \ img ι hold)
    (fun v => if v = ι z0 then 0 else 1)
    (by
      intro v hv
      have : v ≠ ι z0 := fun h => hv ⟨z0, h.symm⟩
      simp [this])
    P _ _ _ _ hok (by rwa [he0, Set.union_empty])
    (by intro a; simp only [hι.eq_iff])
    (fun _ _ => rfl)
    (by
      intro a a' _ hmem
      rw [he0, Set.union_empty] at hmem
      obtain ⟨h1, h2⟩ := hmem
      simp only [Bool.and_eq_true, Bool.not_eq_true']
      refine ⟨(hm a a').mp h1, ?_⟩
      by_contra hh
      exact h2 ⟨a, a', by simpa using hh, rfl⟩)
  have hE : W.edgeSet \ img ι hold ∪ img ι hold = W.edgeSet := by
    rw [Set.sdiff_union_self, Set.union_eq_left]
    rintro e ⟨a, b, h, rfl⟩
    exact hsubW a b h
  rw [hE] at hb'
  unfold Ach at hb'
  rw [fromEdgeSet_edgeSet] at hb'
  obtain ⟨D, hD⟩ := hb'
  refine ⟨D, ?_⟩
  have h1 := D.sum_ends
  have h2 : ∑ v, D.ends v = ∑ v, b' v := Finset.sum_congr rfl (fun v _ => hD v)
  have h4 : ∑ v, b' v = ∑ v : V, (if v = ι z0 then 0 else 1) := hsum
  have h3 : ∑ v : V, (if v = ι z0 then 0 else 1) + 1 = Fintype.card V := by
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ (ι z0))]
    have hrest : ∑ v ∈ Finset.univ.erase (ι z0), (if v = ι z0 then 0 else 1) =
        (Finset.univ.erase (ι z0)).card := by
      rw [Finset.card_eq_sum_ones]
      apply Finset.sum_congr rfl
      intro v hv
      simp [(Finset.mem_erase.mp hv).1]
    rw [hrest, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ]
    have := Fintype.card_pos_iff.mpr ⟨ι z0⟩
    simp only [ite_true]
    omega
  omega

end FiveEven

end Gallai
