def Gallai.ProfileConj.{u} : (V : Type u) → [Fintype V] → [DecidableEq V] → Prop :=
fun V [Fintype V] [DecidableEq V] =>
  ∀ (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj],
    Gallai.TwoConnected G →
      ∀ (Z : Finset V) (b : V → ℕ),
        Z.card ≤ 2 →
          (∀ z ∈ Z, b z = 0) →
            (∀ v ∉ Z, 1 ≤ b v) →
              (∀ (v : V), b v ≤ G.degree v) →
                (∀ (v : V), b v % 2 = G.degree v % 2) →
                  (∀ (x : V), G.degree x + b x ≤ ∑ v, b v) → Gallai.RealisesProfile G b
def Gallai.Conj31On.{u} : (V : Type u) → [Fintype V] → [DecidableEq V] → Prop :=
fun V [Fintype V] [DecidableEq V] =>
  ∀ (H : SimpleGraph V) [inst_2 : DecidableRel H.Adj],
    Gallai.TwoConnected H →
      ∀ (u v : V),
        u ≠ v →
          Gallai.evenSet H = {u, v} →
            (∀ (w : V), 0 < H.degree w) →
              (∀ (w : V), Odd (H.degree w) → H.degree w + 1 < Fintype.card V) → Gallai.Tight H
